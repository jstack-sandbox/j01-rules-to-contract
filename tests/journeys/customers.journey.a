test("CUSTOMER-001/E1, CUSTOMER-003/E1, INVOICE-002/E1 customers list by name, need a phone, and a total of 10.005 shows as 10.01") {
  open("/customers")
  expect(text("Ana Ortiz")).before(text("Ben Lee"))
  open("/customers/new")
  fill("Name", "Cara Diaz")
  click("Save")
  expect(text("a phone number is required")).visible()
  open("/invoices/1")
  expect(text("10.01")).visible()
}
